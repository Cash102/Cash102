{
  "name": "prereq-gap-finder",
  "version": "0.1.0",
  "private": true,
  "description": "Prerequisite gap finder for HSLA \u2014 schema and seed only, no app yet.",
  "scripts": {
    "db:migrate": "prisma migrate dev",
    "db:push": "prisma db push",
    "db:seed": "prisma db seed",
    "db:studio": "prisma studio",
    "typecheck": "tsc --noEmit",
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "verify:stems": "tsx --tsconfig tsconfig.scripts.json scripts/verify-stems.tsx",
    "verify:flow": "tsx --tsconfig tsconfig.scripts.json scripts/e2e-check.mts"
  },
  "dependencies": {
    "@prisma/client": "^6.16.2",
    "katex": "^0.16.22",
    "next": "^14.2.35",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/katex": "^0.16.7",
    "@types/node": "^22.15.3",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "autoprefixer": "^10.5.5",
    "dotenv": "^17.4.2",
    "postcss": "^8.5.28",
    "prisma": "^6.16.2",
    "tailwindcss": "^3.4.19",
    "tsx": "^4.20.3",
    "typescript": "^5.9.2"
  }
}
