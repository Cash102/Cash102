// Prerequisite gap finder — data model
//
// Three layers:
//
//   1. CATALOG   Course + CoursePrerequisite. Straight from the HSLA Directory
//                of Courses. Coarse: "Calculus requires Precalculus."
//
//   2. SKILLS    Skill + CourseSkill + SkillDependency. Written by you and your
//                teachers, not in the catalog. Fine: "a student failing
//                continuity is shaky on factoring." This layer is the product.
//
//   3. DIAGNOSTIC  Question + QuestionOption + Attempt + AttemptAnswer.
//
// Skill is CANONICAL: one row per skill for the whole school. Factoring is one
// record whether Calculus, Chemistry, or Physics leans on it. What varies by
// course — how heavily it is leaned on, what it blocks, what to practice —
// lives on CourseSkill. Two consequences worth knowing before you edit this:
//
//   * "these middle school skills are load-bearing across the school and no
//     course teaches them" is one GROUP BY over Skill, not a de-duplication
//     problem across near-identical rows.
//   * one question serves every course that links to its skill, which is what
//     makes question authoring scale.
//
// An Attempt has no student identity of any kind. Read the note on that model
// before adding a column to it.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  // Runtime connection. On Neon this is the POOLED endpoint (host contains
  // "-pooler"), which is what a serverless app should hold.
  url      = env("DATABASE_URL")
  // Migrations only. Prisma's migration engine needs advisory locks and
  // prepared statements, which a transaction-mode pooler does not provide, so
  // this must be Neon's DIRECT (unpooled) endpoint. Locally, set both to the
  // same URL.
  directUrl = env("DIRECT_URL")
}

// ---------------------------------------------------------------------------
// ENUMS
// ---------------------------------------------------------------------------

/// Mirrors Course["subject"] in the catalog data.
enum Subject {
  English
  History
  Mathematics
  Science
  CollegePersistence @map("College Persistence")
}

/// Mirrors ChainType. Drives how a skill is diagnosed, not just how it renders.
///
/// content — you cannot do the later thing without knowing the earlier thing.
///           Math, science. A question has a right answer.
/// skill   — the gap is procedural, not factual. English, history. A question
///           has a best answer, and every distractor names a specific bad move
///           (summarizing instead of arguing, dropping a quote, restating).
enum ChainType {
  content
  skill
}

// ---------------------------------------------------------------------------
// LAYER 1 — THE CATALOG
// ---------------------------------------------------------------------------

model Course {
  /// The catalog code ("MCFYHAR") is the primary key: it is the join key used
  /// throughout the source data, which makes the seed idempotent and every
  /// foreign key readable in psql.
  code String @id

  title    String
  subject  Subject
  /// Decimal, not Int: the catalog has half-credit courses.
  credits  Decimal @db.Decimal(3, 1)
  required Boolean
  /// e.g. [10, 11]
  grades   Int[]

  externalExam String?
  notes        String?

  /// Derived from notes at seed time ("Not offered SY 25-26"). The course
  /// picker lists only offered courses; the row stays because it is still a
  /// node in the prerequisite graph.
  offered Boolean @default(true)

  /// Edges where this course is the dependent: its prerequisites.
  prerequisites CoursePrerequisite[] @relation("Dependent")
  /// Edges where this course is the prerequisite: what it unlocks.
  unlocks       CoursePrerequisite[] @relation("Prerequisite")

  /// The skills this course leans on, with per-course weight and chain.
  skillLinks CourseSkill[]
  /// Skills taught by this course, when the origin is inside the catalog.
  originOf   Skill[]       @relation("SkillOriginCourse")

  attempts Attempt[]

  @@index([subject])
  @@index([offered])
}

/// One edge of the official prerequisite graph. Explicit rather than an
/// implicit m-n relation because the edges carry data: AP Physics C is
/// "concurrent with or after Calculus BC I", a weaker edge than Calc BC II
/// strictly following Calc BC I.
model CoursePrerequisite {
  /// The later course.
  courseCode       String
  /// The course that must come first.
  prerequisiteCode String

  /// True when the catalog allows taking both in the same year.
  concurrentOk Boolean @default(false)

  course       Course @relation("Dependent", fields: [courseCode], references: [code], onDelete: Cascade)
  prerequisite Course @relation("Prerequisite", fields: [prerequisiteCode], references: [code], onDelete: Cascade)

  @@id([courseCode, prerequisiteCode])
  @@index([prerequisiteCode])
}

// ---------------------------------------------------------------------------
// LAYER 2 — THE SKILL GRAPH
// ---------------------------------------------------------------------------

/// A skill, canonically, for the whole school. Course-neutral by construction:
/// nothing here says "Calculus". If it would read differently for Calculus than
/// for Chemistry, it belongs on CourseSkill instead.
model Skill {
  /// Authored slug ("factoring-quadratics"). Stable across reseeds, so
  /// Question and AttemptAnswer rows survive a catalog refresh.
  id String @id

  name      String
  chainType ChainType

  /// Where the skill is taught, verbatim: "Middle school algebra",
  /// "AP Precalculus", "AP Language and Composition II".
  origin String

  /// Set only when `origin` names a real catalog course. NULL is the finding:
  /// nothing in the high school teaches this skill. Every Calculus skill rooted
  /// in middle school algebra has a NULL here, and
  ///   WHERE "originCourseCode" IS NULL
  /// is the query that states the problem this app exists for.
  originCourseCode String?
  originCourse     Course? @relation("SkillOriginCourse", fields: [originCourseCode], references: [code], onDelete: SetNull)

  /// Retire a skill without deleting answer history.
  active Boolean @default(true)

  courseLinks CourseSkill[]
  questions   Question[]
  answers     AttemptAnswer[]

  /// Edges where this skill is the earlier one: what it holds up.
  blocks  SkillDependency[] @relation("Prerequisite")
  /// Edges where this skill is the later one: what it rests on.
  restsOn SkillDependency[] @relation("Dependent")

  @@index([chainType])
  @@index([originCourseCode])
}

/// One course leaning on one skill. Everything course-specific about a skill
/// lives here, because it genuinely differs per course: factoring is weight 3
/// for Calculus and would be a different weight, with a different chain and a
/// different practice link, for Chemistry.
model CourseSkill {
  courseCode String
  skillId    String

  /// 1-5, how much of THIS course depends on the skill. Validated in the seed;
  /// Prisma cannot emit a Postgres check constraint.
  weight Int

  /// Authored display copy: broken skill -> ... -> the topic it blocks IN THIS
  /// COURSE. Denormalized on purpose — this is what the report renders, with no
  /// traversal. SkillDependency is the structural version of the same idea.
  /// Plain text, NOT stem notation: rendered as escaped text, never as math.
  chain String[]

  /// Khan Academy search string.
  practiceQuery String
  /// Optional hand-picked link, used instead of the search URL when set.
  practiceUrl   String?

  course Course @relation(fields: [courseCode], references: [code], onDelete: Cascade)
  skill  Skill  @relation(fields: [skillId], references: [id], onDelete: Cascade)

  @@id([courseCode, skillId])
  @@index([skillId])
  @@index([courseCode, weight])
}

/// One edge of the skill graph: prerequisite -> dependent, "you need the
/// earlier one to do the later one." Course-neutral, like Skill itself: if
/// factoring holds up rational expressions, it does so in every course.
///
/// The report topologically sorts a student's weak skills over these edges, so
/// it can say "fix factoring FIRST" instead of listing gaps by accuracy.
///
/// The graph must stay acyclic. Nothing in Postgres enforces that; the seed
/// asserts it, and any traversal should still carry a visited-path guard.
model SkillDependency {
  /// The earlier skill.
  prerequisiteId String
  /// The skill that cannot be done without it.
  dependentId    String

  /// 1-5, how completely the dependent fails when the prerequisite is weak.
  /// Distinct from CourseSkill.weight: weight is skill-to-course, strength is
  /// skill-to-skill.
  strength Int @default(3)

  /// One line for the UI: why the later thing breaks without the earlier.
  rationale String?

  prerequisite Skill @relation("Prerequisite", fields: [prerequisiteId], references: [id], onDelete: Cascade)
  dependent    Skill @relation("Dependent", fields: [dependentId], references: [id], onDelete: Cascade)

  @@id([prerequisiteId, dependentId])
  @@index([dependentId])
}

// ---------------------------------------------------------------------------
// LAYER 3 — THE DIAGNOSTIC
// ---------------------------------------------------------------------------

/// A question tests one canonical skill, so it serves every course linked to
/// that skill. Selecting a diagnostic is: course -> CourseSkill -> Skill ->
/// Question.
model Question {
  id String @id @default(cuid())

  skillId String
  skill   Skill  @relation(fields: [skillId], references: [id], onDelete: Cascade)

  /// The stem, in the stored notation format: plain text with math in $...$
  /// (KaTeX subset). NEVER HTML. lib/notation.ts is the only thing allowed to
  /// interpret this column, and it validates on write. See the note there.
  prompt String

  /// Shown after the report, never during. This app diagnoses.
  explanation String?

  /// Retire a bad question without deleting the answers that reference it.
  active Boolean @default(true)

  options QuestionOption[]
  answers AttemptAnswer[]

  @@index([skillId, active])
}

/// One choice. A row rather than a string in an array because a skill-chain
/// question is only diagnostic if the wrong answers mean something: for
/// claim-vs-summary, one distractor is the plot summary, one is the
/// undebatable thesis. `misconception` is what lets the report say which wrong
/// move the student made, not just that they missed it.
model QuestionOption {
  id String @id @default(cuid())

  questionId String
  question   Question @relation(fields: [questionId], references: [id], onDelete: Cascade)

  /// Same notation format as Question.prompt. Never HTML.
  text      String
  isCorrect Boolean @default(false)
  /// Short label for the specific error this option represents.
  misconception String?

  /// Authoring order. The client shuffles at render time, as the prototype does.
  position Int

  answers AttemptAnswer[]

  @@unique([questionId, position])
  @@index([questionId])
}

/// One diagnostic run.
///
/// Anonymous by construction. There is no student, no email, no IP, no user
/// agent, no grade level. The cuid `id` is the only handle; the client keeps it
/// in localStorage to re-open its own report. In a school this size, a course
/// plus a grade plus a timestamp identifies a person, so treat every proposed
/// column here as re-identification risk first and a feature second.
model Attempt {
  id String @id @default(cuid())

  /// The course the student says they are taking now.
  courseCode String
  course     Course @relation(fields: [courseCode], references: [code], onDelete: Restrict)

  startedAt   DateTime  @default(now())
  completedAt DateTime?

  answers AttemptAnswer[]

  @@index([courseCode, completedAt])
}

/// One question answered inside one attempt.
model AttemptAnswer {
  id String @id @default(cuid())

  attemptId String
  attempt   Attempt @relation(fields: [attemptId], references: [id], onDelete: Cascade)

  questionId String
  question   Question @relation(fields: [questionId], references: [id], onDelete: Restrict)

  selectedOptionId String?
  selectedOption   QuestionOption? @relation(fields: [selectedOptionId], references: [id], onDelete: Restrict)

  /// Denormalized from question.skill at write time. Every report groups by
  /// skill, and this stays correct even if a question is later re-pointed.
  skillId String
  skill   Skill  @relation(fields: [skillId], references: [id], onDelete: Cascade)

  /// Resolved at write time so scoring an old attempt never depends on the
  /// option rows having gone unedited.
  correct Boolean

  answeredAt DateTime @default(now())
  /// Milliseconds on the question. Hesitation is signal for skill chains.
  elapsedMs  Int?

  @@unique([attemptId, questionId])
  @@index([attemptId])
  @@index([skillId])
}
